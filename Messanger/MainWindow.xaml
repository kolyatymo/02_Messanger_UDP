<Window x:Class="Messanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Messanger"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Label FontSize="15" FontWeight="Bold" Margin="10">Message : </Label>
            <Button Click="Join_Button_Click" Margin="5" Padding="20 10" DockPanel.Dock="Right">Join</Button>
            <Button Margin="5" Padding="20 10" DockPanel.Dock="Right" Click="Leave_Button_Click">Leave</Button>
            <Button Margin="5" Padding="20 10" DockPanel.Dock="Right" Click="Send_Button_Click">Send</Button>
            <TextBox x:Name="msgTextBox" VerticalContentAlignment="Center"></TextBox>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" FontWeight="Bold" FontSize="25">Chat</TextBlock>
        <ListBox ItemsSource="{Binding}"></ListBox>
    </DockPanel>
</Window>
